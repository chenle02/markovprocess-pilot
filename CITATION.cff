    affiliation: "Department of Mathematics and Statistics, Auburn University"
repository-code: "https://github.com/chenle02/markovprocess-pilot"
license: Apache-2.0
commit: 05d99d75df8235e79902220f0fe13e07e81867ca
keywords:
  - Lean
  - mathlib
  - formal verification
  - Brownian motion
  - optional stopping
  - exit time
preferred-citation:
